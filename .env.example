# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (IBM Code Engine, Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── BLS Public Data API ──────────────────────────────────────────────────────
# Optional. When set, the server automatically uses BLS API v2 (higher limits).
# When absent, the server falls back to BLS API v1 (unauthenticated, lower limits).
#
# v1 limits: 25 series/request, 10-year range, 25 requests/day
# v2 limits: 50 series/request, 20-year range, 500 requests/day
#
# Register for a free key at: https://data.bls.gov/registrationEngine/
# Never commit a real key to version control — keep it in .env (which is gitignored).
#
# BLS_API_KEY=your_registration_key_here

# ─── Evaluation Harness (eval/phoenix/) ──────────────────────────────────────
# IBM watsonx Orchestrate — deployed agent endpoint.
# ORCHESTRATE_BASE_URL: your watsonx.ai regional endpoint (no trailing slash).
# ORCHESTRATE_DEPLOYMENT_ID: the deployment ID shown in Orchestrate UI under
#   Deployments → your deployment → API endpoint.
#
ORCHESTRATE_BASE_URL=https://us-south.ml.cloud.ibm.com
ORCHESTRATE_DEPLOYMENT_ID=your-deployment-id-here

# IBM Cloud API key — exchanged at runtime for a short-lived IAM bearer token.
# This is a separate credential from BLS_API_KEY.
# Generate at: https://cloud.ibm.com/iam/apikeys
#
# IBM_CLOUD_API_KEY=your-ibm-cloud-api-key-here

# Judge model gateway — keep this distinct from the Orchestrate agent model
# to avoid self-preference bias in LLM-as-judge scoring.
# JUDGE_MODEL default if unset: claude_4_6_sonnet
#
# USAI_API_KEY=your-judge-gateway-key-here
# USAI_BASE_URL=https://your-gateway.example.com
# JUDGE_MODEL=claude_4_6_sonnet
