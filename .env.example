# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (IBM Code Engine, Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── BLS Public Data API ──────────────────────────────────────────────────────
# Optional. When set, the server automatically uses BLS API v2 (higher limits).
# When absent, the server falls back to BLS API v1 (unauthenticated, lower limits).
#
# v1 limits: 25 series/request, 10-year range, 25 requests/day
# v2 limits: 50 series/request, 20-year range, 500 requests/day
#
# Register for a free key at: https://data.bls.gov/registrationEngine/
# Never commit a real key to version control — keep it in .env (which is gitignored).
#
# BLS_API_KEY=your_registration_key_here
