# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (IBM Code Engine, Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── BLS Public Data API ──────────────────────────────────────────────────────
# Optional. When set, the server automatically uses BLS API v2 (higher limits).
# When absent, the server falls back to BLS API v1 (unauthenticated, lower limits).
#
# v1 limits: 25 series/request, 10-year range, 25 requests/day
# v2 limits: 50 series/request, 20-year range, 500 requests/day
#
# Register for a free key at: https://data.bls.gov/registrationEngine/
# Never commit a real key to version control — keep it in .env (which is gitignored).
#
# BLS_API_KEY=your_registration_key_here

# ─── Evaluation Harness (eval/phoenix/) ──────────────────────────────────────
# IBM watsonx Orchestrate — chat completions API endpoint.
# ORCHESTRATE_BASE_URL: your Orchestrate instance base URL (not the ML API URL).
#   Format: https://<region>.watson-orchestrate.cloud.ibm.com
#   e.g.    https://ca-tor.watson-orchestrate.cloud.ibm.com
# ORCHESTRATE_AGENT_ID: UUID of your deployed agent. Find it in the Orchestrate
#   UI: open the agent → the UUID appears in the browser URL or agent details.
#   This is the same UUID used in /v1/orchestrate/{agent_id}/chat/completions
#
# ORCHESTRATE_BASE_URL=https://<region>.watson-orchestrate.cloud.ibm.com
# ORCHESTRATE_AGENT_ID=your-agent-uuid-here

# IBM Cloud API key — used by both the Orchestrate agent (IAM token exchange)
# and the judge LLM (via langchain-ibm / LiteLLM watsonx provider).
# This is a separate credential from BLS_API_KEY.
# Generate at: https://cloud.ibm.com/iam/apikeys
#
# WATSONX_API_KEY=your-ibm-cloud-api-key-here
# IBM_CLOUD_API_KEY=your-ibm-cloud-api-key-here   # used by agent.py IAM exchange

# watsonx.ai regional endpoint — must match the region of your project.
# Dallas: https://us-south.ml.cloud.ibm.com  Frankfurt: https://eu-de.ml.cloud.ibm.com
# London: https://eu-gb.ml.cloud.ibm.com     Tokyo:     https://jp-tok.ml.cloud.ibm.com
#
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# watsonx.ai project ID — required by langchain-ibm and the LiteLLM judge adapter.
# Find it: project → Manage → General → Details → Project ID
#
# WATSONX_PROJECT_ID=your-project-id-here

# Judge model (watsonx.ai model ID, keep distinct from the Orchestrate agent model).
# Must be available in your region; check with the model listing command in the
# mcp-eval-wxai skill. Default if unset: meta-llama/llama-3-3-70b-instruct
#
# JUDGE_MODEL=meta-llama/llama-3-3-70b-instruct
